{
  "expo": {
    "name": "YAi Retro Camera",
    "slug": "yai-retro-camera",
    "version": "0.1.0",
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eai.retrocamera"
    },
    "android": {
      "package": "com.eai.retrocamera",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "YAi Retro Camera требует доступ к камере для съёмки ретро-видео.",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "YAi Retro Camera требует доступ к микрофону для записи звука видеороликов."
        }
      ],
      "./plugins/withStageZeroAndroid"
    ],
    "newArchEnabled": false
  }
}
