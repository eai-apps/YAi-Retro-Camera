{
  "expo": {
    "name": "YAi Retro Camera",
    "slug": "yai-retro-camera",
    "version": "0.2.0",
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eai.retrocamera"
    },
    "android": {
      "package": "com.eai.retrocamera",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive.png",
        "backgroundColor": "#14171e"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "YAi Retro Camera требует доступ к камере для съёмки ретро-видео.",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "YAi Retro Camera требует доступ к микрофону для записи звука видеороликов."
        }
      ],
      "./plugins/withStageZeroAndroid",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Доступ к камере для фото и видео.",
          "microphonePermission": "Доступ к микрофону для звука видео."
        }
      ]
    ],
    "newArchEnabled": false,
    "icon": "./assets/brand/icon.png"
  }
}
